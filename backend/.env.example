# Backend Environment Configuration Template
ENVIRONMENT=development

# Database Configuration (PostgreSQL / Supabase)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myfitsync
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=prefer

# Security
SECRET_KEY=replace_with_a_secure_random_secret_min_32_chars_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,https://my-fit-sync.vercel.app,https://myfitsync.vercel.app

# AI Coach (Groq)
GROQ_API_KEY=
COACH_ENABLED=false
COACH_MODEL=llama-3.3-70b-versatile
COACH_MAX_TOKENS=600
COACH_DAILY_LIMIT=20
COACH_GLOBAL_DAILY_LIMIT=1000
COACH_CRISIS_MESSAGE=
