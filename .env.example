# Environment Configuration Example for MyFitSync
# Copy to .env and replace placeholder values before running. Never commit .env!

# Environment mode: development | production | test
ENVIRONMENT=development

# SQL Server Configuration
MSSQL_SA_PASSWORD=ChangeMe_StrongSaP@ssw0rd123!
APP_DB_USER=myfitsync_app
APP_DB_PASSWORD=ChangeMe_AppP@ssw0rd123!
DB_HOST=sql1
DB_PORT=1433
DB_NAME=MyFitSyncDB

# Backend Security
SECRET_KEY=replace_with_a_secure_random_secret_in_production_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS & Server
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
BACKEND_PORT=8000
FRONTEND_PORT=3000
